# Telegram credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Access control (comma-separated Telegram user IDs)
ADMIN_USER_IDS=your_telegram_user_id
ALLOWED_USER_IDS=

# Multi-user rate limiting & upload settings
MAX_UPLOAD_MB=2000
MAX_CONCURRENT_DOWNLOADS=3
MAX_USER_CONCURRENT_DOWNLOADS=1
COMMAND_COOLDOWN_SEC=3
DOWNLOAD_COOLDOWN_SEC=30
DAILY_DOWNLOAD_LIMIT=15
PAGE_SIZE=5

# Storage paths (leave DOWNLOAD_DIR empty to use system temp)
DOWNLOAD_DIR=
BOT_DATA_FILE=bot_data.json
